<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_order_form_inherit" model="ir.ui.view">
        <field name="name">sale.order.form.inherit</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <field name="tag_ids" position="attributes">
                <attribute name="invisible">1</attribute>
            </field>
            <xpath expr="//header" position="inside">
                <field name="is_job_card_created" invisible="1"/>
                <button name="create_job_card" string="Create Job Card" type="object" class="btn-primary"
                        attrs="{'invisible': [('is_job_card_created', '=', True)]}"/>
            </xpath>
            <field name="partner_id" position="before">
                <field name="title"/>
                <field name="is_insurance"/>
                <field name="insurance_company_id" attrs="{'invisible': [('is_insurance', '!=', True)]}"/>
            </field>
            <field name="partner_id" position="after">
                <field name="project_id"/>
                <field name="policy_no"/>
                <field name="lpo_no" invisible="1"/>
                <field name="lpo_date"/>
                <field name="claim_no"/>
		<field name="tag_ids"/>
            </field>
            <field name="payment_term_id" position="after">
                <field name="vehicle"/>
                <field name="registration_no" readonly="1"/>
                <field name="vehicle_make" readonly="1"/>
                <field name="vehicle_model" readonly="1"/>
                <field name="vehicle_type" readonly="1"/>
                <field name="vehicle_color" readonly="1"/>
                <field name="vin" readonly="1"/>
                <field name="engin_no" readonly="1"/>
                <field name="gears" readonly="1"/>
                <field name="year" readonly="1"/>
                <field name="fuel_type" readonly="1"/>
            </field>
             <xpath expr="//field[@name='order_line']//tree//field[@name='product_id']" position="before">
                <field name="cost_type"/>
            </xpath>
            <xpath expr="//field[@name='order_line']//tree//field[@name='price_unit']" position="before">
                <field name="cc_sale_price"/>
            </xpath>
            <xpath expr="//field[@name='order_line']//tree//field[@name='price_unit']" position="attributes">
                <attribute name="string">Sales Price</attribute>
            </xpath>
<!--            <xpath expr="//field[@name='order_line']//tree//field[@name='price_unit']" position="after">-->
<!--                <button name="action_increase_price" type="object" icon="fa-arrow-up" string="10%" class="btn-link"/>-->
<!--            </xpath>-->
            <xpath expr="//field[@name='order_line']//tree//field[@name='price_subtotal']" position="attributes">
                <attribute name="string">Amount</attribute>
            </xpath>
            <xpath expr="//field[@name='order_line']//tree//field[@name='discount']" position="attributes">
                <attribute name="string">Discount</attribute>
            </xpath>
        </field>
    </record>

    <record id="view_quotation_tree_inherit" model="ir.ui.view">
            <field name="name">sale.order.tree</field>
            <field name="model">sale.order</field>
            <field name="inherit_id" ref="sale.view_quotation_tree"/>
            <field name="arch" type="xml">
                <field name="partner_id" position="before">
                    <field name="insurance_company_id" optional="show"/>
                </field>
                <field name="partner_id" position="after">
                    <field name="registration_no" optional="show"/>
                    <field name="vehicle_make" optional="show"/>
                    <field name="vehicle_model" optional="show"/>
                </field>
                <field name="state" position="before">
                    <field name="tag_ids" optional="show"/>
                </field>
            </field>
        </record>

    <record id="view_sales_order_filter_inherit" model="ir.ui.view">
            <field name="name">sale.order.search.inherit.quotation</field>
            <field name="model">sale.order</field>
            <field name="inherit_id" ref="sale.view_sales_order_filter"/>
            <field name="arch" type="xml">
                <field name="name" position="after">
                    <field name="insurance_company_id"/>
                </field>
            </field>
        </record>

    <record id="sale.action_quotations_with_onboarding" model="ir.actions.act_window">
            <field name="name">Estimate</field>
    </record>

    <menuitem id="sale.sale_menu_root"
    name="Estimates"
    />

</odoo>
